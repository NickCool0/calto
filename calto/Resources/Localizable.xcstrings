      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключение"
          }
        }
      }
    },
    "Could not request calendar access: %@": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось запросить доступ к календарю: %@"
