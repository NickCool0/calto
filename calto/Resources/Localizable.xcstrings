        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Система"
          }
        }
      }
    },
    "Text is recognized on the device and only the text is sent; images never leave your Mac. Layouts such as tables may be read less accurately.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Текст распознаётся на устройстве, отправляется только он — изображения не покидают Mac. Таблицы и сложная вёрстка могут распознаться хуже."
          }
        }
      }
