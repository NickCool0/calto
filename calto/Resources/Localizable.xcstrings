        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "повторений: %lld"
          }
        }
      }
    },
    "until %@": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "до %@"
          }
        }
      }
    }
