{
  "sourceLanguage": "en",
  "strings": {
    "%@ before": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "за %@"
          }
        }
      }
    },
    "%@ — 1 reminder per event": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — 1 напоминание на событие"
          }
        }
      }
    },
    "API key": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "API-ключ"
          }
        }
      }
    },
    "API key (optional)": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "API-ключ (необязательно)"
          }
        }
      }
    },
    "Access": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ"
          }
        }
      }
    },
    "Add a reminder": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавить напоминание"
          }
        }
      }
    },
    "Add a title.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте название."
          }
        }
      }
    },
    "Add an API key and choose a model in Settings to recognize events.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы распознавать события, добавьте API-ключ и выберите модель в настройках."
          }
        }
      }
    },
    "Add to Calendar (%lld)": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавить в Календарь (%lld)"
          }
        }
      }
    },
    "Add-only (full access required)": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только добавление (нужен полный доступ)"
          }
        }
      }
    },
    "Added to every request, together with what you type in the popup.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавляется к каждому запросу вместе с тем, что вы пишете в окне calto."
          }
        }
      }
    },
    "After each calto update macOS asks once for the Keychain password to read the key. Choose “Always Allow” so it doesn’t ask again.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После каждого обновления calto macOS один раз спрашивает пароль связки ключей, чтобы прочитать ключ. Выберите «Разрешать всегда», чтобы она больше не спрашивала."
          }
        }
      }
    },
    "All day": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Весь день"
          }
        }
      }
    },
    "Allow": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешить"
          }
        }
      }
    },
    "Allow calto in Login Items to finish.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы завершить, разрешите calto в разделе «Объекты входа»."
          }
        }
      }
    },
    "Always read screenshots on this Mac": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всегда распознавать скриншоты на этом Mac"
          }
        }
      }
    },
    "Any server with an OpenAI-compatible API: a local model (Ollama, LM Studio, osaurus) or an aggregator like OpenRouter.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Любой сервер с OpenAI-совместимым API: локальная модель (Ollama, LM Studio, osaurus) или агрегатор вроде OpenRouter."
          }
        }
      }
    },
    "Apple Intelligence (on device)": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence (на устройстве)"
          }
        }
      }
    },
    "Apple’s model couldn’t process the request: %@": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Модель Apple не смогла обработать запрос: %@"
          }
        }
      }
    },
    "Apple’s on-device model: free, private, works offline. Screenshots are read with on-device text recognition.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Модель Apple на устройстве: бесплатно, приватно, работает без интернета. Скриншоты читаются локальным распознаванием текста."
          }
        }
      }
    },
    "At start time": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В момент начала"
          }
        }
      }
    },
    "Available on this Mac. Nothing leaves your computer.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступна на этом Mac. Данные не покидают компьютер."
          }
        }
      }
    },
    "Back": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Назад"
          }
        }
      }
    },
    "Calendar": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Календарь"
          }
        }
      }
    },
    "Calendar access is off. Allow it in System Settings → Privacy & Security → Calendars.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ к календарям выключен. Разрешите его в Системных настройках → Конфиденциальность и безопасность → Календари."
          }
        }
      }
    },
    "Calendar access: add-only (full access required)": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ к календарю: только добавление (нужен полный доступ)"
          }
        }
      }
    },
    "Calendar access: denied": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ к календарю: запрещён"
          }
        }
      }
    },
    "Calendar access: granted": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ к календарю: разрешён"
          }
        }
      }
    },
    "Calendar access: not requested yet": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ к календарю: ещё не запрошен"
          }
        }
      }
    },
    "Calendar app’s default": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как в Календаре"
          }
        }
      }
    },
    "Calendar for new events": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Календарь для новых событий"
          }
        }
      }
    },
    "Calendars": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Календари"
          }
        }
      }
    },
    "Canned answers for development: every line of text becomes an event. Nothing is sent anywhere.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заготовленные ответы для разработки: каждая строка текста становится событием. Ничего никуда не отправляется."
          }
        }
      }
    },
    "Can’t connect to %@. For a local model, make sure Ollama or LM Studio is running.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось подключиться к %@. Для локальной модели проверьте, что Ollama или LM Studio запущены."
          }
        }
      }
    },
    "Can’t connect to the server.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось подключиться к серверу."
          }
        }
      }
    },
    "Change the model": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сменить модель"
          }
        }
      }
    },
    "Check Key and Load Models": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверить ключ и загрузить модели"
          }
        }
      }
    },
    "Choose a calendar": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите календарь"
          }
        }
      }
    },
    "Choose from the loaded models": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбрать из загруженных моделей"
          }
        }
      }
    },
    "Clear": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Очистить"
          }
        }
      }
    },
    "Connected. Models available: %lld.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключено. Доступно моделей: %lld."
          }
        }
      }
    },
