      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Конец"
          }
        }
      }
    },
    "Enter an API key first.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
