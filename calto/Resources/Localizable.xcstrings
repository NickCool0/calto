          "stringUnit": {
            "state": "translated",
            "value": "Настройки calto"
          }
        }
      }
    },
    "calto can only add events. Allow full access to check for conflicts and duplicates.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "calto может только добавлять события. Разрешите полный доступ, чтобы проверять конфликты и дубликаты."
          }
        }
      }
    },
    "calto can’t read “%@”. Drag the file into the window instead.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "calto не может прочитать «%@». Перетащите файл в окно."
          }
        }
      }
    },
    "calto is processing your request…": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "calto обрабатывает запрос…"
          }
        }
      }
    },
    "calto needs access to your calendars to add events.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "calto нужен доступ к календарям, чтобы добавлять события."
          }
        }
      }
    },
