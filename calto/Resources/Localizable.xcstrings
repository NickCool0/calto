        }
      }
    },
    "Couldn’t read the end “%@”; the default duration is used.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось распознать окончание «%@»; использована длительность по умолчанию."
          }
        }
      }
    },
    "Couldn’t read the key from the Keychain: %@": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось прочитать ключ из Связки ключей: %@"
